{
  "name": "vm-manager",
  "version": "1.0.0",
  "description": "Hyper-V VM Manager with network management",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-packager . VM-Manager --platform=win32 --arch=x64 --out=dist --overwrite"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^40.4.0",
    "electron-packager": "^17.1.1"
  },
  "build": {
    "win": {
        "requestedExecutionLevel": "requireAdministrator"
    }
  }
}
